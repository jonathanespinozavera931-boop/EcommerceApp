<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NexHard</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NexHard.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/glass-theme.css" />
</head>
<body class="glass-page">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>

    <div class="app-shell">
        <nav class="glass-navbar">
            <div class="container d-flex align-items-center justify-content-between">
                <a class="brand-gradient" asp-area="" asp-controller="Home" asp-action="Index">NexHard</a>
                <div class="d-flex align-items-center gap-1 flex-wrap">
                    <a class="nav-pill" asp-controller="Home" asp-action="Index">Inicio</a>
                    <a class="nav-pill" asp-controller="Products" asp-action="Index">Componentes</a>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <!-- Módulos SOLO para Administradores -->
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="nav-pill" asp-controller="Proveedores" asp-action="Index">Proveedores</a>
                            <a class="nav-pill" asp-controller="Clientes" asp-action="Index">Clientes</a>
                            <a class="nav-pill" asp-controller="OrdenesCompra" asp-action="Index">Órdenes</a>
                        }

                        <a class="nav-pill cart-pill" asp-controller="Products" asp-action="Index">
                            🛒<span class="cart-badge" id="cartBadge">0</span>
                        </a>
                        <span class="nav-pill">Hola, @User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="nav-pill cta">Cerrar sesión</button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-pill" asp-controller="Account" asp-action="Register">Registrarse</a>
                        <a class="nav-pill cta" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                    }
                </div>
            </div>
        </nav>

        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted" style="border-color:rgba(255,255,255,.1) !important;">
            <div class="container">
                &copy; 2026 - NexHard - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>