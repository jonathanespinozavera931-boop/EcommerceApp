    <!-- ═══════════════ SERVICE WORKER + PWA ═══════════════ -->
    <script>
            // ══════════ REGISTRAR SERVICE WORKER ══════════
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', () => {
                    navigator.serviceWorker.register('/service-worker.js')
                        .then(reg => console.log('✅ Service Worker registrado:', reg.scope))
                        .catch(err => console.log('❌ Error SW:', err));
                });
            }

            // ══════════ PWA INSTALL PROMPT ══════════
            let deferredPrompt = null;
            const pwaInstallBox = document.getElementById('pwaInstallBox');
            const pwaInstallBtn = document.getElementById('pwaInstallBtn');
            const pwaCloseBtn = document.getElementById('pwaCloseBtn');

            if (window.matchMedia('(display-mode: standalone)').matches) {
                if (pwaInstallBox) pwaInstallBox.style.display = 'none';
            }

            window.addEventListener('beforeinstallprompt', (e) => {
                e.preventDefault();
                deferredPrompt = e;
                setTimeout(() => {
                    if (pwaInstallBox) pwaInstallBox.classList.add('show');
                }, 3000);
            });

            pwaInstallBtn?.addEventListener('click', async (e) => {
                if (e.target.closest('.wt-pwa-close')) return;

                if (deferredPrompt) {
                    deferredPrompt.prompt();
                    const { outcome } = await deferredPrompt.userChoice;
                    if (outcome === 'accepted') {
                        pwaInstallBox.classList.remove('show');
                    }
                    deferredPrompt = null;
                } else {
                    alert('📱 Para instalar la app:\n\nChrome Android: Menú (⋮) → "Instalar aplicación"\niOS Safari: Compartir → "Añadir a pantalla de inicio"\nEscritorio: Clic en el ícono de instalar en la barra de direcciones');
                }
            });

            pwaCloseBtn?.addEventListener('click', (e) => {
                e.stopPropagation();
                pwaInstallBox.classList.remove('show');
                sessionStorage.setItem('pwaDismissed', 'true');
            });

            if (sessionStorage.getItem('pwaDismissed') === 'true') {
                if (pwaInstallBox) pwaInstallBox.style.display = 'none';
            }
    </script>

    <!-- ═══════════════ BUSCADOR + DRAWER + VOZ ═══════════════ -->
    <script>
            // ============ BUSCADOR ============
            const searchInput = document.getElementById('irisSearch');
            const searchBtn = document.getElementById('irisSearchBtn');

            function doSearch() {
                const term = searchInput.value.trim();
                if (term) {
                    window.location.href = '/Products?search=' + encodeURIComponent(term);
                }
            }

            searchInput?.addEventListener('keypress', e => {
                if (e.key === 'Enter') doSearch();
            });
            searchBtn?.addEventListener('click', doSearch);

            // ============ DRAWER MÓVIL ============
            const hamburger = document.getElementById('irisHamburger');
            const drawer = document.getElementById('irisDrawer');
            const overlay = document.getElementById('irisOverlay');

            hamburger?.addEventListener('click', () => {
                drawer.classList.add('open');
                overlay.classList.add('open');
            });

            overlay?.addEventListener('click', () => {
                drawer.classList.remove('open');
                overlay.classList.remove('open');
            });

            // ============ MARCAR LINK ACTIVO ============
            const currentPath = window.location.pathname;
            document.querySelectorAll('.iris-nav-link').forEach(link => {
                const href = link.getAttribute('href');
                if (href && currentPath === href) {
                    link.classList.add('active');
                }
            });

            // ============ BOTÓN VOLVER ARRIBA ============
            const backToTop = document.getElementById('backToTop');
            if (backToTop) {
                window.addEventListener('scroll', () => {
                    if (window.scrollY > 400) {
                        backToTop.classList.add('visible');
                    } else {
                        backToTop.classList.remove('visible');
                    }
                });
            }

            // ══════════════════════════════════════════════════
            // ══════════ ASISTENTE DE VOZ IA ══════════
            // ══════════════════════════════════════════════════
            const voiceBtn = document.getElementById('voiceAssistantBtn');
            const voiceBubble = document.getElementById('voiceBubble');
            const voiceBubbleText = document.getElementById('voiceBubbleText');

            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            let recognition = null;
            let isListening = false;

            function mostrarBurbuja(texto, tiempo = 4000) {
                if (!voiceBubble || !voiceBubbleText) return;
                voiceBubbleText.textContent = texto;
                voiceBubble.classList.add('show');

                clearTimeout(window.voiceBubbleTimeout);
                window.voiceBubbleTimeout = setTimeout(() => {
                    voiceBubble.classList.remove('show');
                }, tiempo);
            }

            function hablar(texto) {
                if ('speechSynthesis' in window) {
                    window.speechSynthesis.cancel();
                    const utterance = new SpeechSynthesisUtterance(texto);
                    utterance.lang = 'es-ES';
                    utterance.rate = 1.0;
                    utterance.pitch = 1.0;
                    window.speechSynthesis.speak(utterance);
                }
            }

            function procesarComando(texto) {
                const t = texto.toLowerCase().trim();
                console.log('🎤 Comando:', t);

                // Saludo
                if (t.includes('hola') || t.includes('hey') || t.includes('buenas')) {
                    mostrarBurbuja('¡Hola! Puedes decir: "buscar RTX 4090", "ir a procesadores", "abrir carrito"...');
                    hablar('Hola, ¿en qué puedo ayudarte?');
                    return;
                }

                // Buscar
                if (t.includes('buscar') || t.includes('busca') || t.includes('quiero ver') || t.includes('muéstrame')) {
                    let termino = t
                        .replace('buscar', '').replace('busca', '')
                        .replace('quiero ver', '').replace('muéstrame', '')
                        .replace('por favor', '').trim();

                    if (termino) {
                        mostrarBurbuja(`🔍 Buscando "${termino}"...`);
                        hablar(`Buscando ${termino}`);
                        setTimeout(() => {
                            window.location.href = '/Products?search=' + encodeURIComponent(termino);
                        }, 1200);
                    } else {
                        mostrarBurbuja('¿Qué producto quieres buscar?');
                        hablar('¿Qué producto quieres buscar?');
                    }
                    return;
                }

                // Categorías
                const categorias = {
                    'procesador': 'CPU', 'procesadores': 'CPU', 'cpu': 'CPU',
                    'tarjeta': 'GPU', 'tarjetas': 'GPU', 'gráfica': 'GPU', 'gráficas': 'GPU', 'gpu': 'GPU', 'video': 'GPU',
                    'ram': 'RAM', 'memoria': 'RAM',
                    'almacenamiento': 'Almacenamiento', 'disco': 'Almacenamiento', 'ssd': 'Almacenamiento',
                    'placa': 'Placa Madre', 'motherboard': 'Placa Madre',
                    'fuente': 'Fuente',
                    'refrigeración': 'Refrigeración', 'cooler': 'Refrigeración',
                    'gabinete': 'Gabinete', 'case': 'Gabinete',
                    'monitor': 'Monitor', 'monitores': 'Monitor', 'pantalla': 'Monitor',
                    'periférico': 'Periférico', 'periféricos': 'Periférico', 'teclado': 'Periférico', 'mouse': 'Periférico'
                };

                for (const [key, cat] of Object.entries(categorias)) {
                    if (t.includes(key)) {
                        mostrarBurbuja(`📦 Mostrando ${cat}...`);
                        hablar(`Mostrando ${cat}`);
                        setTimeout(() => {
                            window.location.href = '/Products?category=' + encodeURIComponent(cat);
                        }, 1200);
                        return;
                    }
                }

                // Navegación
                if (t.includes('inicio') || t.includes('home') || t.includes('principal')) {
                    mostrarBurbuja('🏠 Yendo al inicio...');
                    hablar('Yendo al inicio');
                    setTimeout(() => window.location.href = '/', 1000);
                    return;
                }

                if (t.includes('carrito')) {
                    mostrarBurbuja('🛒 Abriendo carrito...');
                    hablar('Abriendo tu carrito');
                    setTimeout(() => window.location.href = '/Cart', 1000);
                    return;
                }

                if (t.includes('pedidos') || t.includes('compras')) {
                    mostrarBurbuja('📦 Viendo tus pedidos...');
                    hablar('Yendo a tus pedidos');
                    setTimeout(() => window.location.href = '/Orders/MyOrders', 1000);
                    return;
                }

                if (t.includes('contacto') || t.includes('contactar')) {
                    mostrarBurbuja('📞 Abriendo contacto...');
                    hablar('Abriendo contacto');
                    setTimeout(() => window.location.href = '/Home/Contact', 1000);
                    return;
                }

                if (t.includes('cuenta') || t.includes('login') || t.includes('iniciar sesión')) {
                    mostrarBurbuja('👤 Yendo a iniciar sesión...');
                    hablar('Yendo a iniciar sesión');
                    setTimeout(() => window.location.href = '/Account/Login', 1000);
                    return;
                }

                // Buscar por defecto
                if (t.length > 2) {
                    mostrarBurbuja(`🔍 Buscando "${texto}"...`);
                    hablar(`Buscando ${texto}`);
                    setTimeout(() => {
                        window.location.href = '/Products?search=' + encodeURIComponent(texto);
                    }, 1200);
                } else {
                    mostrarBurbuja('No entendí. Intenta: "buscar RTX 4090", "ir a procesadores", "abrir carrito"...');
                    hablar('No entendí, intenta de nuevo');
                }
            }

            // Inicializar reconocimiento
            if (SpeechRecognition) {
                recognition = new SpeechRecognition();
                recognition.lang = 'es-ES';
                recognition.continuous = false;
                recognition.interimResults = false;
                recognition.maxAlternatives = 1;

                recognition.onstart = () => {
                    isListening = true;
                    voiceBtn.classList.add('listening');
                    mostrarBurbuja('🎤 Escuchando...', 10000);
                };

                recognition.onend = () => {
                    isListening = false;
                    voiceBtn.classList.remove('listening');
                };

                recognition.onerror = (e) => {
                    isListening = false;
                    voiceBtn.classList.remove('listening');
                    console.error('Error voz:', e.error);

                    if (e.error === 'not-allowed') {
                        mostrarBurbuja('❌ Debes permitir el acceso al micrófono.');
                    } else if (e.error === 'no-speech') {
                        mostrarBurbuja('No escuché nada. Intenta de nuevo.');
                    } else {
                        mostrarBurbuja('Error al escuchar. Intenta de nuevo.');
                    }
                };

                recognition.onresult = (event) => {
                    const texto = event.results[0][0].transcript;
                    procesarComando(texto);
                };

                voiceBtn?.addEventListener('click', () => {
                    if (isListening) {
                        recognition.stop();
                    } else {
                        try {
                            recognition.start();
                        } catch (e) {
                            console.log('Ya está escuchando');
                        }
                    }
                });
            } else {
                voiceBtn?.addEventListener('click', () => {
                    mostrarBurbuja('❌ Tu navegador no soporta comandos de voz. Prueba con Chrome o Edge.');
                });
            }

            // Mostrar bienvenida (una vez por sesión)
            setTimeout(() => {
                if (!sessionStorage.getItem('voiceWelcomeShown')) {
                    mostrarBurbuja('👋 ¡Hola! Soy tu asistente. Dime "buscar RTX 4090" o "ir a procesadores".', 6000);
                    sessionStorage.setItem('voiceWelcomeShown', 'true');
                }
            }, 4000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>