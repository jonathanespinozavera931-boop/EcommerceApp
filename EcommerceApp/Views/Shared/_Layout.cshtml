                <a class="iris-nav-link" asp-controller="Products" asp-action="Index" asp-route-category="GPU">Tarjetas de Video</a>
                <a class="iris-nav-link" asp-controller="Products" asp-action="Index" asp-route-category="RAM">Memoria RAM</a>
