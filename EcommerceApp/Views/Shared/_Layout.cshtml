<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NexHard</title>

    <!-- ═══════════════ CSS ═══════════════ -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/white-tech.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    <!-- ═══════════════ PWA MANIFEST ═══════════════ -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF003C" />
    <link rel="apple-touch-icon" href="/images/logo-nexhard.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="NexHard" />
</head>

<body>

    <!-- ==================== NAVBAR PREMIUM ==================== -->
    <nav class="iris-navbar">

        <!-- ==== FILA SUPERIOR (DARK) ==== -->
        <div class="iris-nav-top">
            <div class="iris-nav-top-inner">

                <!-- Hamburguesa -->
                <button class="iris-hamburger" id="irisHamburger" aria-label="Menú">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>

                <!-- Logo -->
                <a class="iris-logo" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo-nexhard.png" alt="NexHard" />
                </a>

                <!-- Buscador -->
                <div class="iris-search">
                    <input type="text" id="irisSearch" placeholder="Buscar productos..." />
                    <button class="iris-search-btn" id="irisSearchBtn" title="Buscar">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </button>
                    <button type="button" class="iris-search-btn" id="voiceSearchBtn" title="Buscar por voz">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                            <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                            <line x1="12" y1="19" x2="12" y2="23"></line>
                            <line x1="8" y1="23" x2="16" y2="23"></line>
                        </svg>
                    </button>
                </div>

                <!-- Iconos acciones -->
                <div class="iris-top-actions">

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a class="iris-user-info" href="#" title="Mi cuenta">
                            <div class="iris-user-avatar">@User.Identity.Name?.Substring(0, 1).ToUpper()</div>
                            <span class="iris-user-name">@User.Identity.Name</span>
                        </a>

                        <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                            <button type="submit" class="iris-btn-logout" title="Cerrar sesión">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                    <polyline points="16 17 21 12 16 7"></polyline>
                                    <line x1="21" y1="12" x2="9" y2="12"></line>
                                </svg>
                            </button>
                        </form>
                    }
                    else
                    {
