<!-- ==================== EQUIPA TU SETUP ==================== -->
<section class="iris-section">
    <div class="container">
        @{
            var productosSetup = ViewBag.ProductosSetup as List<EcommerceApp.Models.Product> ?? new List<EcommerceApp.Models.Product>();
        }

        <div class="iris-setup-banner">

            <!-- VIDEO DE FONDO -->
            <div class="iris-setup-video">
                <iframe src="https://www.youtube.com/embed/H4nJo-oqAro?autoplay=1&mute=1&loop=1&playlist=H4nJo-oqAro&controls=0&showinfo=0&modestbranding=1&playsinline=1"
                        allow="autoplay; encrypted-media"
                        allowfullscreen>
                </iframe>
            </div>

            <!-- CONTENIDO -->
            <div class="iris-setup-content">
                <span class="iris-setup-eyebrow">🎮 NEXHARD</span>
                <h2 class="iris-setup-title">Equipa tu<br />Setup</h2>
                <p class="iris-setup-subtitle">
                    Todo para tu escritorio gamer, productivo o profesional en un solo lugar.
                </p>
                <a asp-controller="Products" asp-action="Index" class="iris-setup-btn">
                    Comprar ahora →
                </a>
            </div>

            <!-- PRODUCTOS REALES -->
            <div class="iris-setup-products">
                @if (productosSetup.Any())
                {
                    foreach (var prod in productosSetup)
                    {
                        <a class="iris-setup-product" asp-controller="Products" asp-action="Details" asp-route-id="@prod.Id">
                            <span class="iris-setup-product-sku">SKU fijo</span>
                            <div class="iris-setup-product-img">
                                @if (!string.IsNullOrEmpty(prod.ImageUrl))
                                {
                                    <img src="@prod.ImageUrl" alt="@prod.Name"
                                         onerror="this.style.display='none'; this.parentElement.innerHTML='<div style=&quot;font-size:3rem;opacity:0.4;&quot;>🖥️</div>';" />
                                }
                                else
                                {
                                    <div style="font-size:3rem;opacity:0.4;">🖥️</div>
                                }
                            </div>
                            <div class="iris-setup-product-info">
                                <span class="iris-setup-product-cat">@prod.Category</span>
                                <h4 class="iris-setup-product-name">@prod.Name</h4>
                                <div class="iris-setup-product-price">Bs @prod.Price.ToString("N2")</div>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div style="grid-column: 1 / -1; text-align: center; color: white; padding: 30px;">
                        <p>Cargando productos...</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

