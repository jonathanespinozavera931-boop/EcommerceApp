            <a class="iris-category-item" asp-controller="Products" asp-action="Index" asp-route-category="GPU"
               style="background-image: url('https://images.unsplash.com/photo-1555617766-c94804975da3?w=600&q=80');">
                <span class="iris-category-item-badge">@(categorias.ContainsKey("GPU") ? categorias["GPU"] : 0) productos</span>
                <span class="iris-category-item-name">Tarjetas de Video</span>
            </a>

            <a class="iris-category-item" asp-controller="Products" asp-action="Index" asp-route-category="RAM"
               style="background-image: url('https://images.unsplash.com/photo-1541029071515-84cc54f84dc5?w=600&q=80');">
                <span class="iris-category-item-badge">@(categorias.ContainsKey("RAM") ? categorias["RAM"] : 0) productos</span>
                <span class="iris-category-item-name">Memoria RAM</span>
