<!-- ==================== ÚLTIMAS NOVEDADES ==================== -->
<section class="iris-section">
    <div class="container">
        <div class="iris-section-header">
            <div>
                <h2 class="iris-section-title">Últimas <span class="highlight">novedades</span></h2>
                <p class="iris-section-subtitle">Promos, nuevos productos y ofertas exclusivas</p>
            </div>
            <a asp-controller="Products" asp-action="Index" class="iris-section-btn">
                Ver novedades →
            </a>
        </div>

        @{
            var productoDestacado = ViewBag.ProductoDestacado as EcommerceApp.Models.Product;
            var productosMini = ViewBag.ProductosMini as List<EcommerceApp.Models.Product>;

            string IconFor(string? category) => category switch
            {
                "GPU" => "🎮",
                "CPU" => "🧠",
                "RAM" => "💾",
                "Almacenamiento" => "💿",
                "Placa Madre" => "🔌",
                "Fuente" => "⚡",
                "Refrigeración" => "❄️",
                "Gabinete" => "📦",
                "Monitor" => "🖥️",
                "Periférico" => "🖱️",
                _ => "🔧"
            };
        }

        <div class="iris-novedades-grid">

            <!-- PRODUCTO DESTACADO GRANDE -->
            @if (productoDestacado != null)
            {
                <a asp-controller="Products" asp-action="Details" asp-route-id="@productoDestacado.Id"
                   class="iris-novedad-featured">

                    <div class="iris-novedad-featured-img"
                         style="background-image: url('@(string.IsNullOrEmpty(productoDestacado.ImageUrl) ? "" : productoDestacado.ImageUrl)');">
                    </div>

                    <div class="iris-novedad-featured-content">
                        <span class="iris-novedad-featured-badge">🔥 DESTACADO</span>
                        <div class="iris-novedad-featured-cat">
                            @IconFor(productoDestacado.Category) @productoDestacado.Category
                        </div>
                        <h3 class="iris-novedad-featured-title">@productoDestacado.Name</h3>
                        <p class="iris-novedad-featured-desc">@productoDestacado.Description</p>

                        <div class="iris-novedad-featured-footer">
                            <div class="iris-novedad-featured-price">Bs @productoDestacado.Price.ToString("N2")</div>
                            <span class="iris-novedad-featured-btn">
                                Ver producto →
                            </span>
                        </div>
                    </div>
                </a>
            }

            <!-- LISTA MINI (3 productos) -->
            <div class="iris-novedades-list">
                @if (productosMini != null)
                {
                    foreach (var item in productosMini)
                    {
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id"
                           class="iris-novedad-item">

                            <!-- IMAGEN GRANDE -->
                            <div class="iris-novedad-item-img">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name"
                                         onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=&quot;iris-novedad-item-placeholder&quot;>@IconFor(item.Category)</div>';" />
                                }
                                else
                                {
                                    <div class="iris-novedad-item-placeholder">@IconFor(item.Category)</div>
                                }
                            </div>

                            <!-- INFO -->
                            <div class="iris-novedad-item-content">
                                <span class="iris-novedad-item-brand">@item.Category</span>
                                <h3 class="iris-novedad-item-name">@item.Name</h3>
                                <p class="iris-novedad-item-desc">@item.Description</p>

                                <div class="iris-novedad-item-footer">
                                    <span class="iris-novedad-item-price">Bs @item.Price.ToString("N2")</span>
                                </div>
                            </div>

                            <!-- FLECHA -->
                            <div class="iris-novedad-item-arrow">→</div>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</section>

<!-- ==================== CATEGORÍAS ==================== -->
<section class="iris-section" style="background: var(--bg-white);">
    <div class="container">
        <div class="iris-section-header">
            <div>
                <h2 class="iris-section-title">Explorá por <span class="highlight">categorías</span></h2>
                <p class="iris-section-subtitle">Encuentra lo que necesitas en un solo lugar</p>
            </div>
        </div>

        @{
            var categoriasHome = ViewBag.Categorias as Dictionary<string, int> ?? new Dictionary<string, int>();
            var imagenesCategorias = new Dictionary<string, string>
    {
        { "CPU", "https://images.unsplash.com/photo-1591799264318-7e6ef8ddb7ea?w=600&q=80" },
        { "GPU", "https://images.unsplash.com/photo-1555617766-c94804975da3?w=600&q=80" },
        { "RAM", "https://images.unsplash.com/photo-1541029071515-84cc54f84dc5?w=600&q=80" },
        { "Almacenamiento", "https://images.unsplash.com/photo-1531492746076-161ca9bcad58?w=600&q=80" },
        { "Placa Madre", "https://images.unsplash.com/photo-1518770660439-4636190af475?w=600&q=80" },
        { "Fuente", "https://images.unsplash.com/photo-1587202372634-32705e3bf49c?w=600&q=80" },
        { "Refrigeración", "https://images.unsplash.com/photo-1597049097286-c9e77151bf01?w=600&q=80" },
        { "Gabinete", "https://images.unsplash.com/photo-1587302912306-cf1ed9c33146?w=600&q=80" },
        { "Periférico", "https://images.unsplash.com/photo-1527814050087-3793815479db?w=600&q=80" },
        { "Monitor", "https://images.unsplash.com/photo-1527443224154-c4a3942d3acf?w=600&q=80" },
    };
        }

        <div class="iris-categories-grid">
            @foreach (var cat in categoriasHome)
            {
                var imgUrl = imagenesCategorias.ContainsKey(cat.Key) ? imagenesCategorias[cat.Key] : "";
                var nombreCat = cat.Key switch
                {
                    "CPU" => "Procesadores",
                    "GPU" => "Tarjetas de Video",
                    "RAM" => "Memoria RAM",
                    "Almacenamiento" => "Almacenamiento",
                    "Placa Madre" => "Placas Madre",
                    "Fuente" => "Fuentes de Poder",
                    "Refrigeración" => "Refrigeración",
                    "Gabinete" => "Gabinetes",
                    "Periférico" => "Periféricos",
                    "Monitor" => "Monitores",
                    _ => cat.Key
                };

                <a class="iris-category-item" asp-controller="Products" asp-action="Index" asp-route-category="@cat.Key">
                    <div class="iris-cat-bg" style="background-image: url('@imgUrl');"></div>
                    <span class="iris-category-item-badge">@cat.Value productos</span>
                    <span class="iris-category-item-name">@nombreCat</span>
                </a>
            }
        </div>
    </div>
</section>

