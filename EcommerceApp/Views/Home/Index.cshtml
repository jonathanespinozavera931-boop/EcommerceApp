@{
    ViewData["Title"] = "Inicio";
    var categorias = ViewBag.Categorias as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<!-- ==================== BANNER SLIDER ==================== -->
<section class="iris-slider" id="irisSlider">
    <div class="iris-slider-track" id="sliderTrack">

        <!-- SLIDE 1 -->
        <div class="iris-slide" style="background-image: url('https://images.unsplash.com/photo-1542751371-adc38448a05e?w=1920&q=80');">
            <div class="iris-slide-content">
                <span class="iris-slide-eyebrow">🔥 Ofertas de la semana</span>
                <h1 class="iris-slide-title">
                    TODO LO QUE TU<br />
                    <span class="highlight">PC NECESITA</span>
                    AL MEJOR PRECIO
                </h1>
                <p class="iris-slide-subtitle">
                    Encontrá los mejores componentes, periféricos y accesorios para armar la máquina de tus sueños.
                </p>
                <a asp-controller="Products" asp-action="Index" class="iris-slide-btn">
                    Explorar Componentes →
                </a>
            </div>
        </div>

        <!-- SLIDE 2 -->
        <div class="iris-slide" style="background-image: url('https://images.unsplash.com/photo-1593640408182-31c70c8268f5?w=1920&q=80');">
            <div class="iris-slide-content">
                <span class="iris-slide-eyebrow">💻 Nuevos ingresos</span>
                <h1 class="iris-slide-title">
                    NOTEBOOKS<br />
                    <span class="highlight">PARA GAMING</span>
                    Y PRODUCTIVIDAD
                </h1>
                <p class="iris-slide-subtitle">
                    Potencia máxima en cualquier lugar. Marcas líderes con garantía oficial.
                </p>
                <a asp-controller="Products" asp-action="Index" class="iris-slide-btn">
                    Ver Notebooks →
                </a>
            </div>
        </div>

        <!-- SLIDE 3 -->
        <div class="iris-slide" style="background-image: url('https://images.unsplash.com/photo-1591488320449-011701bb6704?w=1920&q=80');">
            <div class="iris-slide-content">
                <span class="iris-slide-eyebrow">⚡ Hardware Premium</span>
                <h1 class="iris-slide-title">
                    EQUIPA TU SETUP<br />
                    <span class="highlight">AL NIVEL PRO</span>
                    QUE MERECÉS
                </h1>
                <p class="iris-slide-subtitle">
                    Componentes de las mejores marcas con envío a todo Bolivia.
                </p>
                <a asp-controller="Products" asp-action="Index" class="iris-slide-btn">
                    Ver Catálogo →
                </a>
            </div>
        </div>

    </div>

    <button class="iris-slider-arrow prev" id="sliderPrev">‹</button>
    <button class="iris-slider-arrow next" id="sliderNext">›</button>

    <div class="iris-slider-dots" id="sliderDots">
        <button class="iris-slider-dot active" data-slide="0"></button>
        <button class="iris-slider-dot" data-slide="1"></button>
        <button class="iris-slider-dot" data-slide="2"></button>
    </div>
</section>

<!-- ==================== BANNER ENTREGAS ==================== -->
<div class="container">
    <div class="iris-delivery-banner">
        <div class="iris-delivery-banner-icon">🚚</div>
        <div class="iris-delivery-banner-text">
            <h3>Entregas a Nivel Nacional</h3>
            <p>Realizamos entregas a todos los departamentos de Bolivia</p>
        </div>
    </div>
</div>

<!-- ==================== ÚLTIMAS NOVEDADES ==================== -->
<section class="iris-section">
    <div class="container">
        <div class="iris-section-header">
            <div>
                <h2 class="iris-section-title">Últimas <span class="highlight">novedades</span></h2>
                <p class="iris-section-subtitle">Promos, nuevos productos y ofertas exclusivas</p>
            </div>
            <a asp-controller="Products" asp-action="Index" class="iris-section-btn">
                Ver novedades →
            </a>
        </div>

        <div class="iris-novedades-grid">
            <!-- Featured grande -->
            <a asp-controller="Products" asp-action="Index" class="iris-novedad-featured"
               style="background-image: url('https://images.unsplash.com/photo-1587202372775-e229f172b9d7?w=800&q=80');">
                <div class="iris-novedad-featured-content">
                    <span class="iris-novedad-featured-badge">🔥 Destacado</span>
                    <h3 class="iris-novedad-featured-title">Equipos con IA integrada</h3>
                    <p class="iris-novedad-featured-desc">Las PCs más inteligentes del mercado ya están disponibles en NexHard</p>
                </div>
            </a>

            <!-- Lista de productos -->
            <div class="iris-novedades-list">

                <a asp-controller="Products" asp-action="Index" class="iris-novedad-item">
                    <div class="iris-novedad-item-img">
                        <img src="https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=200&q=80" alt="Teclado" />
                    </div>
                    <div class="iris-novedad-item-content">
                        <span class="iris-novedad-item-brand">CORSAIR</span>
                        <h3 class="iris-novedad-item-name">Corsair K100 RGB Teclado Mecánico</h3>
                        <div class="iris-novedad-item-price">Bs 311</div>
                    </div>
                </a>

                <a asp-controller="Products" asp-action="Index" class="iris-novedad-item">
                    <div class="iris-novedad-item-img">
                        <img src="https://images.unsplash.com/photo-1615663245857-ac93bb7c39e7?w=200&q=80" alt="Mouse" />
                    </div>
                    <div class="iris-novedad-item-content">
                        <span class="iris-novedad-item-brand">REDRAGON</span>
                        <h3 class="iris-novedad-item-name">Redragon Olaf K648 Teclado RGB</h3>
                        <div class="iris-novedad-item-price">Bs 115</div>
                    </div>
                </a>

                <a asp-controller="Products" asp-action="Index" class="iris-novedad-item">
                    <div class="iris-novedad-item-img">
                        <img src="https://images.unsplash.com/photo-1527814050087-3793815479db?w=200&q=80" alt="Mouse Gaming" />
                    </div>
                    <div class="iris-novedad-item-content">
                        <span class="iris-novedad-item-brand">LOGITECH</span>
                        <h3 class="iris-novedad-item-name">Logitech G Pro X Superlight 2</h3>
                        <div class="iris-novedad-item-price">Bs 159</div>
                    </div>
                </a>

            </div>
        </div>
    </div>
</section>

<!-- ==================== CATEGORÍAS ==================== -->
<section class="iris-section" style="background: var(--bg-gray);">
    <div class="container">
        <div class="iris-section-header">
            <div>
                <h2 class="iris-section-title">Explorá por <span class="highlight">categorías</span></h2>
                <p class="iris-section-subtitle">Encuentra lo que necesitas en un solo lugar</p>
            </div>
        </div>

        <div class="iris-categories-grid">

            <a class="iris-category-item" asp-controller="Products" asp-action="Index" asp-route-category="CPU"
               style="background-image: url('https://images.unsplash.com/photo-1591799264318-7e6ef8ddb7ea?w=600&q=80');">
                <span class="iris-category-item-badge">@(categorias.ContainsKey("CPU") ? categorias["CPU"] : 0) productos</span>
                <span class="iris-category-item-name">Procesadores</span>
