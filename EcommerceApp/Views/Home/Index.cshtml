               style="background-image: url('https://images.unsplash.com/photo-1531492746076-161ca9bcad58?w=600&q=80');">
                <span class="iris-category-item-badge">@(categorias.ContainsKey("Almacenamiento") ? categorias["Almacenamiento"] : 0) productos</span>
                <span class="iris-category-item-name">Almacenamiento</span>
            </a>

            <a class="iris-category-item" asp-controller="Products" asp-action="Index" asp-route-category="Placa Madre"
               style="background-image: url('https://images.unsplash.com/photo-1518770660439-4636190af475?w=600&q=80');">
                <span class="iris-category-item-badge">@(categorias.ContainsKey("Placa Madre") ? categorias["Placa Madre"] : 0) productos</span>
                <span class="iris-category-item-name">Placas Madre</span>
            </a>

            <a class="iris-category-item" asp-controller="Products" asp-action="Index" asp-route-category="Fuente"
               style="background-image: url('https://images.unsplash.com/photo-1587202372634-32705e3bf49c?w=600&q=80');">
                <span class="iris-category-item-badge">@(categorias.ContainsKey("Fuente") ? categorias["Fuente"] : 0) productos</span>
                <span class="iris-category-item-name">Fuentes de Poder</span>
            </a>

            <a class="iris-category-item" asp-controller="Products" asp-action="Index" asp-route-category="Refrigeración"
               style="background-image: url('https://images.unsplash.com/photo-1597049097286-c9e77151bf01?w=600&q=80');">
                <span class="iris-category-item-badge">@(categorias.ContainsKey("Refrigeración") ? categorias["Refrigeración"] : 0) productos</span>
                <span class="iris-category-item-name">Refrigeración</span>
            </a>

            <a class="iris-category-item" asp-controller="Products" asp-action="Index" asp-route-category="Gabinete"
               style="background-image: url('https://images.unsplash.com/photo-1587302912306-cf1ed9c33146?w=600&q=80');">
                <span class="iris-category-item-badge">@(categorias.ContainsKey("Gabinete") ? categorias["Gabinete"] : 0) productos</span>
                <span class="iris-category-item-name">Gabinetes</span>
            </a>

            <a class="iris-category-item" asp-controller="Products" asp-action="Index" asp-route-category="Periférico"
               style="background-image: url('https://images.unsplash.com/photo-1527814050087-3793815479db?w=600&q=80');">
                <span class="iris-category-item-badge">@(categorias.ContainsKey("Periférico") ? categorias["Periférico"] : 0) productos</span>
                <span class="iris-category-item-name">Periféricos</span>
            </a>

            <a class="iris-category-item" asp-controller="Products" asp-action="Index" asp-route-category="Monitor"
               style="background-image: url('https://images.unsplash.com/photo-1527443224154-c4a3942d3acf?w=600&q=80');">
                <span class="iris-category-item-badge">@(categorias.ContainsKey("Monitor") ? categorias["Monitor"] : 0) productos</span>
