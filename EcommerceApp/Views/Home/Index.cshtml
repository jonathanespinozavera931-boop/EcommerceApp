@{
    ViewData["Title"] = "Inicio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<!-- ==================== HERO SECTION ==================== -->
<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <span class="hero-badge">⚡ Tienda de hardware para PC</span>
            <h1 class="hero-title">
                Construye la <span class="gradient-text">máquina</span><br />
                de tus sueños
            </h1>
            <p class="hero-subtitle">
                En NexHard encontrarás los mejores componentes, periféricos y accesorios
                para armar, mejorar y potenciar tu setup al máximo. Calidad garantizada,
                envíos a todo Bolivia.
            </p>

            <div class="hero-cta">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a class="btn-hero-primary" asp-controller="Products" asp-action="Index">
                        Explorar componentes →
                    </a>
                    <a class="btn-hero-outline" asp-controller="Home" asp-action="Privacy">
                        Conocer más
                    </a>
                }
                else
                {
                    <a class="btn-hero-primary" asp-controller="Account" asp-action="Register">
                        Crear cuenta gratis →
                    </a>
                    <a class="btn-hero-outline" asp-controller="Account" asp-action="Login">
                        Iniciar sesión
                    </a>
                }
            </div>

            <!-- Trust badges -->
            <div class="trust-badges">
                <div class="trust-item">
                    <span class="trust-icon">✅</span>
                    <div class="trust-text">
                        <h4>Productos originales</h4>
                        <p>y garantizados</p>
                    </div>
                </div>
                <div class="trust-item">
                    <span class="trust-icon">🚚</span>
                    <div class="trust-text">
                        <h4>Envíos a todo</h4>
                        <p>Bolivia</p>
                    </div>
                </div>
                <div class="trust-item">
                    <span class="trust-icon">🔒</span>
                    <div class="trust-text">
                        <h4>Pagos seguros</h4>
                        <p>y confiables</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==================== CATEGORÍAS ==================== -->
<section class="section">
    <div class="container">
        <div class="section-header">
            <span class="section-eyebrow">Explora</span>
            <h2 class="section-title">Categorías destacadas</h2>
            <p class="section-subtitle">Encuentra exactamente lo que buscas para tu próxima build</p>
        </div>

        @{
            var categorias = ViewBag.Categorias as Dictionary<string, int> ?? new Dictionary<string, int>();
        }

        <div class="categories-grid">
            @foreach (var cat in categorias)
            {
                <a class="category-card" asp-controller="Products" asp-action="Index" asp-route-category="@cat.Key">
                    <span class="category-icon">
                        @switch (cat.Key)
                        {
                            case "CPU":
                                <text>🧠</text>
                                break;
                            case "GPU":

                                <text>🎮</text>
                                break;
                            case "RAM":

                                <text>💾</text>
                                break;
                            case "Almacenamiento":

                                <text>💿</text>
                                break;
                            case "Placa Madre":

                                <text>🔌</text>
                                break;
                            case "Fuente":

                                <text>⚡</text>
                                break;
                            case "Refrigeración":

                                <text>❄️</text>
                                break;
                            case "Gabinete":

                                <text>📦</text>
                                break;
                            case "Periférico":

                                <text>🖱️</text>
                                break;
                            case "Monitor":

                                <text>🖥️</text>
                                break;
                            default:

                                <text>🛒</text>
                                break;
                        }
                    </span>
                    <span class="category-name">@cat.Key</span>
                    @if (cat.Value > 0)
                    {
                        <span class="category-count">@cat.Value @(cat.Value == 1 ? "producto" : "productos")</span>
                    }
                    else
                    {
                        <span class="category-count empty">Sin stock</span>
                    }
                </a>
            }
        </div>
    </div>
</section>

<!-- ==================== PRODUCTOS DESTACADOS ==================== -->
<section class="section" style="background: rgba(0,0,0,0.2);">
    <div class="container">
        <div class="section-header">
            <span class="section-eyebrow">🔥 Los más vendidos</span>
            <h2 class="section-title">Productos destacados</h2>
            <p class="section-subtitle">Los favoritos de nuestra comunidad gamer</p>
        </div>

        <div class="products-preview">
            <div class="product-preview-card">
                <span class="product-badge">🔥 Más vendido</span>
                <h3>NVIDIA GeForce RTX 4090</h3>
                <p style="color:#8892a0; font-size:0.85rem; margin:0;">24GB GDDR6X · Ray Tracing · 4K</p>
                <div class="product-price">Bs 1,899.99</div>
                <a class="product-cta" asp-controller="Products" asp-action="Index">Comprar ahora →</a>
            </div>

            <div class="product-preview-card">
                <span class="product-badge">⭐ Nuevo</span>
                <h3>AMD Ryzen 9 7950X3D</h3>
                <p style="color:#8892a0; font-size:0.85rem; margin:0;">16 núcleos · 32 hilos · 5.7 GHz</p>
                <div class="product-price">Bs 749.99</div>
                <a class="product-cta" asp-controller="Products" asp-action="Index">Comprar ahora →</a>
            </div>

            <div class="product-preview-card">
                <span class="product-badge">✨ Mejor valorado</span>
                <h3>Corsair Vengeance RGB PRO DDR5</h3>
                <p style="color:#8892a0; font-size:0.85rem; margin:0;">32GB (2x16GB) · 6000MHz · RGB</p>
                <div class="product-price">Bs 329.99</div>
                <a class="product-cta" asp-controller="Products" asp-action="Index">Comprar ahora →</a>
            </div>
        </div>
    </div>
</section>

<!-- ==================== VIDEO ==================== -->
