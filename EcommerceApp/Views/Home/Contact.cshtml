@{
    ViewData["Title"] = "Contacto";
}

<!-- ==================== HERO CONTACTO ==================== -->
<section class="iris-section" style="padding-top: 40px;">
    <div class="container">
        <div class="wt-section-header" style="text-align: left; margin-bottom: 40px;">
            <span class="wt-section-eyebrow">Contacto</span>
            <h1 class="wt-section-title">Estamos aquí para <span class="wt-highlight-red">ayudarte</span></h1>
            <p class="wt-section-subtitle" style="max-width: none;">
                Tienes dudas, consultas o sugerencias? Escríbenos y te responderemos a la brevedad.
            </p>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1.3fr; gap: 40px; align-items: start;">

            <!-- INFO DE CONTACTO -->
            <div style="display: flex; flex-direction: column; gap: 20px;">

                <div class="tech-card">
                    <div style="display: flex; align-items: center; gap: 14px;">
                        <div style="width: 50px; height: 50px; background: var(--rog-red-soft); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">📍</div>
                        <div>
                            <h3 style="font-family: var(--font-heading); font-weight: 700; font-size: 0.9rem; text-transform: uppercase; margin: 0 0 4px;">Dirección</h3>
                            <p style="color: var(--text-secondary); margin: 0; font-size: 0.88rem;">WOW La elegancia del calzado</p>
                        </div>
                    </div>
                </div>

                <div class="tech-card">
                    <div style="display: flex; align-items: center; gap: 14px;">
                        <div style="width: 50px; height: 50px; background: var(--rog-red-soft); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">📞</div>
                        <div>
                            <h3 style="font-family: var(--font-heading); font-weight: 700; font-size: 0.9rem; text-transform: uppercase; margin: 0 0 4px;">Teléfono</h3>
                            <p style="color: var(--text-secondary); margin: 0; font-size: 0.88rem;">+591 777 77777</p>
                        </div>
                    </div>
                </div>

                <div class="tech-card">
                    <div style="display: flex; align-items: center; gap: 14px;">
                        <div style="width: 50px; height: 50px; background: var(--rog-red-soft); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">✉️</div>
                        <div>
                            <h3 style="font-family: var(--font-heading); font-weight: 700; font-size: 0.9rem; text-transform: uppercase; margin: 0 0 4px;">Email</h3>
                            <p style="color: var(--text-secondary); margin: 0; font-size: 0.88rem;">contacto@nexhard.com</p>
                        </div>
                    </div>
                </div>

                <div class="tech-card">
                    <div style="display: flex; align-items: center; gap: 14px;">
                        <div style="width: 50px; height: 50px; background: var(--rog-red-soft); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">🕐</div>
                        <div>
                            <h3 style="font-family: var(--font-heading); font-weight: 700; font-size: 0.9rem; text-transform: uppercase; margin: 0 0 4px;">Horarios</h3>
                            <p style="color: var(--text-secondary); margin: 0; font-size: 0.88rem;">Lun - Vie: 9:00 - 19:00<br />Sáb: 9:00 - 14:00</p>
                        </div>
                    </div>
                </div>

            </div>

            <!-- FORMULARIO -->
            <div class="tech-card" style="padding: 36px;">
                <h2 style="font-family: var(--font-display); font-weight: 800; font-size: 1.4rem; text-transform: uppercase; margin: 0 0 24px;">Envíanos un mensaje</h2>

                <form onsubmit="event.preventDefault(); alert('¡Gracias! Tu mensaje ha sido enviado. Te responderemos pronto.'); this.reset();"
                      style="display: flex; flex-direction: column; gap: 18px;">

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <div>
                            <label style="display:block; font-family: var(--font-heading); font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px;">Nombre</label>
                            <input type="text" required placeholder="Tu nombre"
                                   style="width:100%; padding: 12px 16px; background: var(--bg-gray); border: 1.5px solid transparent; border-radius: 10px; font-size: 0.9rem;" />
                        </div>
                        <div>
                            <label style="display:block; font-family: var(--font-heading); font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px;">Email</label>
                            <input type="email" required placeholder="tu@email.com"
                                   style="width:100%; padding: 12px 16px; background: var(--bg-gray); border: 1.5px solid transparent; border-radius: 10px; font-size: 0.9rem;" />
                        </div>
                    </div>

                    <div>
                        <label style="display:block; font-family: var(--font-heading); font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px;">Asunto</label>
                        <input type="text" required placeholder="¿En qué podemos ayudarte?"
                               style="width:100%; padding: 12px 16px; background: var(--bg-gray); border: 1.5px solid transparent; border-radius: 10px; font-size: 0.9rem;" />
                    </div>

                    <div>
                        <label style="display:block; font-family: var(--font-heading); font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px;">Mensaje</label>
                        <textarea required rows="5" placeholder="Cuéntanos tu consulta..."
                                  style="width:100%; padding: 12px 16px; background: var(--bg-gray); border: 1.5px solid transparent; border-radius: 10px; font-size: 0.9rem; resize: vertical;"></textarea>
                    </div>

                    <button type="submit" class="wt-btn-primary" style="justify-content: center; padding: 14px;">
                        Enviar Mensaje →
                    </button>
                </form>
            </div>

        </div>

        <!-- MAPA -->
        <div style="margin-top: 50px;">
            <h2 style="font-family: var(--font-display); font-weight: 800; font-size: 1.4rem; text-transform: uppercase; margin: 0 0 20px;">Encuéntranos aquí</h2>
            <div style="height: 400px; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md);">
                <iframe src="https://maps.google.com/maps?q=WOW+La+elegancia+del+calzado&t=&z=15&ie=UTF8&iwloc=&output=embed"
                        width="100%" height="100%" style="border:none;" loading="lazy"></iframe>
            </div>
        </div>
    </div>
</section>