@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - NexHard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/white-tech.css" />
</head>
<body>

    <div class="iris-auth-page">
        <div class="iris-auth-card">

            <!-- LOGO -->
            <div class="iris-auth-logo">
                <img src="~/images/logo.png" alt="NexHard" />
            </div>

            <!-- TÍTULOS -->
            <div class="iris-auth-header">
                <h1 class="iris-auth-title">Bienvenido</h1>
                <p class="iris-auth-subtitle">Inicia sesión para ver el catálogo</p>
            </div>

            <!-- FORMULARIO -->
            <form asp-action="Login" method="post" class="iris-auth-form">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="iris-auth-error" style="display:none;"></div>

                <div class="iris-auth-group">
                    <label asp-for="Email">Correo</label>
                    <input asp-for="Email" class="iris-auth-input" placeholder="vos@ejemplo.com" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size:0.75rem;"></span>
                </div>

                <div class="iris-auth-group">
                    <label asp-for="Password">Contraseña</label>
                    <input asp-for="Password" class="iris-auth-input" type="password" placeholder="••••••••" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger" style="font-size:0.75rem;"></span>
                </div>

                <label class="iris-auth-checkbox">
                    <input asp-for="RememberMe" type="checkbox" />
                    <span>Recordarme</span>
                </label>

                <button type="submit" class="iris-auth-btn">
                    Ingresar →
                </button>
            </form>

            <!-- DIVIDER -->
            <div class="iris-auth-divider">o continuar con</div>

            <!-- GOOGLE -->
            <form asp-controller="Account" asp-action="ExternalLogin" method="post">
                <button type="submit" name="provider" value="Google" class="iris-auth-google">
                    <svg width="20" height="20" viewBox="0 0 48 48">
                        <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.9 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 8 3l6-6C34.5 5.1 29.5 3 24 3 12.4 3 3 12.4 3 24s9.4 21 21 21 21-9.4 21-21c0-1.4-.1-2.7-.4-4z" />
                        <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.6 15.6 18.9 13 24 13c3.1 0 5.8 1.1 8 3l6-6C34.5 6.1 29.5 4 24 4 16.3 4 9.6 8.3 6.3 14.7z" />
                        <path fill="#4CAF50" d="M24 44c5.2 0 10.1-2 13.7-5.2l-6.3-5.3C29.4 35.4 26.8 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.7 16.2 44 24 44z" />
                        <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-1.1 3-3.4 5.4-6.3 6.8l6.3 5.3C39.4 36.8 44 30.9 44 24c0-1.4-.1-2.7-.4-3.5z" />
                    </svg>
                    Continuar con Google
                </button>
            </form>

            <!-- REGISTRO -->
            <div class="iris-auth-footer">
                ¿No tienes cuenta? <a asp-action="Register">Regístrate gratis</a>
            </div>

        </div>
    </div>

</body>
</html>