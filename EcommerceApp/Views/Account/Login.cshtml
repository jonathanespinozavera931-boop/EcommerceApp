@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Iniciar sesión</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/glass-theme.css" />
</head>
<body class="glass-page auth-bg">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="glass-wrap">
        <div class="glass-card">
            <h1>Bienvenido</h1>
            <p class="sub">Iniciá sesión para ver el catálogo</p>
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <label asp-for="Email">Correo</label>
                <input asp-for="Email" class="form-control" placeholder="vos@ejemplo.com" />
                <span asp-validation-for="Email" class="text-danger"></span>

                <label asp-for="Password">Contraseña</label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger"></span>

                <button type="submit" class="glass-btn">Ingresar</button>
            </form>
            <div style="display:flex;align-items:center;gap:12px;margin:20px 0;">
                <div style="flex:1;height:1px;background:rgba(255,255,255,.12);"></div>
                <span style="color:var(--muted);font-size:12.5px;">o</span>
                <div style="flex:1;height:1px;background:rgba(255,255,255,.12);"></div>
            </div>
            <a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="Google"
               style="display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:12px;
                border-radius:12px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);
                color:var(--text);text-decoration:none;font-size:14px;font-weight:500;">
                <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.9 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 8 3l6-6C34.5 5.1 29.5 3 24 3 12.4 3 3 12.4 3 24s9.4 21 21 21 21-9.4 21-21c0-1.4-.1-2.7-.4-4z" /><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.6 15.6 18.9 13 24 13c3.1 0 5.8 1.1 8 3l6-6C34.5 6.1 29.5 4 24 4 16.3 4 9.6 8.3 6.3 14.7z" /><path fill="#4CAF50" d="M24 44c5.2 0 10.1-2 13.7-5.2l-6.3-5.3C29.4 35.4 26.8 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.7 16.2 44 24 44z" /><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-1.1 3-3.4 5.4-6.3 6.8l6.3 5.3C39.4 36.8 44 30.9 44 24c0-1.4-.1-2.7-.4-3.5z" /></svg>
                Continuar con Google
            </a>
            <div class="glass-footer-link">
                ¿No tenés cuenta? <a asp-action="Register">Registrate</a>
            </div>


    </div>
</body>
</html>