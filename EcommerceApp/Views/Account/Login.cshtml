@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión - NexHard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
            /* Estilos Globales para la página de Login */
            body {
                margin: 0;
                padding: 0;
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                /* Fondo de pantalla completa */
                background-image: url('/images/fondo-login.jpg');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                background-attachment: fixed;
                font-family: 'Inter', sans-serif;
                color: #ffffff;
            }

            /* Tarjeta de Login (Glassmorphism) */
            .login-card {
                background: rgba(10, 12, 22, 0.85); /* Fondo oscuro semitransparente */
                backdrop-filter: blur(16px); /* Efecto de desenfoque */
                -webkit-backdrop-filter: blur(16px);
                border: 1px solid rgba(0, 224, 255, 0.2); /* Borde cian sutil */
                border-radius: 16px;
                box-shadow: 0 0 40px rgba(0, 224, 255, 0.15); /* Resplandor neón */
                padding: 40px;
                width: 100%;
                max-width: 420px;
                box-sizing: border-box;
                text-align: center;
            }

            /* Logo */
            .login-logo {
                max-width: 160px;
                height: auto;
                margin-bottom: 20px;
                display: block;
                margin-left: auto;
                margin-right: auto;
                filter: drop-shadow(0 0 10px rgba(0, 224, 255, 0.5)); /* Resplandor al logo */
            }

            /* Títulos */
            h1 {
                font-family: 'Space Grotesk', sans-serif;
                font-size: 2rem;
                font-weight: 700;
                margin: 0 0 10px 0;
                color: #ffffff;
                letter-spacing: 0.5px;
            }

            .sub {
                font-size: 0.95rem;
                color: #a0aab5;
                margin: 0 0 30px 0;
            }

            /* Formulario */
            form {
                display: flex;
                flex-direction: column;
                gap: 15px;
                text-align: left;
            }

            label {
                font-size: 0.85rem;
                color: #a0aab5;
                margin-bottom: 5px;
                display: block;
            }

            .form-control {
                width: 100%;
                padding: 14px 16px;
                background: rgba(0, 0, 0, 0.4);
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 10px;
                color: #ffffff;
                font-size: 0.95rem;
                font-family: 'Inter', sans-serif;
                box-sizing: border-box;
                transition: all 0.3s ease;
            }

                .form-control:focus {
                    outline: none;
                    border-color: #00e0ff;
                    box-shadow: 0 0 0 3px rgba(0, 224, 255, 0.2);
                    background: rgba(0, 0, 0, 0.6);
                }

                .form-control::placeholder {
                    color: #555;
                }

            .text-danger {
                color: #ff4d4d;
                font-size: 0.8rem;
                margin-top: 5px;
                display: block;
            }

            /* Botón Ingresar */
            .btn-primary {
                margin-top: 10px;
                padding: 14px;
                background: linear-gradient(90deg, #00e0ff, #a020f0);
                border: none;
                border-radius: 10px;
                color: #ffffff;
                font-size: 1rem;
                font-weight: 600;
                font-family: 'Space Grotesk', sans-serif;
                cursor: pointer;
                transition: transform 0.2s, box-shadow 0.2s;
                letter-spacing: 0.5px;
            }

                .btn-primary:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 25px rgba(0, 224, 255, 0.4);
                }

            /* Divisor "o" */
            .divider {
                display: flex;
                align-items: center;
                text-align: center;
                margin: 20px 0;
                color: #555;
                font-size: 0.8rem;
            }

                .divider::before,
                .divider::after {
                    content: '';
                    flex: 1;
                    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                }

                .divider::before {
                    margin-right: 15px;
                }

                .divider::after {
                    margin-left: 15px;
                }

            /* Botón de Google */
            .btn-google {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                width: 100%;
                padding: 12px;
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 255, 255, 0.15);
                border-radius: 10px;
                color: #ffffff;
                text-decoration: none;
                font-size: 0.95rem;
                font-family: 'Inter', sans-serif;
                font-weight: 500;
                cursor: pointer;
                transition: background 0.3s, border-color 0.3s;
            }

                .btn-google:hover {
                    background: rgba(255, 255, 255, 0.1);
                    border-color: rgba(255, 255, 255, 0.3);
                }

            /* Enlace de Registro */
            .register-link {
                margin-top: 25px;
                font-size: 0.9rem;
                color: #a0aab5;
            }

                .register-link a {
                    color: #00e0ff;
                    text-decoration: none;
                    font-weight: 600;
                    transition: color 0.3s;
                }

                    .register-link a:hover {
                        color: #a020f0;
                        text-decoration: underline;
                    }
    </style>
</head>
<body>

    <div class="login-card">
        <!-- Logo -->
        <img src="~/images/logo.png" alt="NexHard Logo" class="login-logo" />

        <h1>Bienvenido</h1>
        <p class="sub">Iniciá sesión para ver el catálogo</p>

        <!-- Formulario de Login Principal -->
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div>
                <label asp-for="Email">Correo</label>
                <input asp-for="Email" class="form-control" placeholder="vos@ejemplo.com" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Password">Contraseña</label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-primary">Ingresar</button>
        </form>

        <!-- Divisor -->
        <div class="divider">o</div>

        <!-- Botón de Google (Usando el formulario correcto para OAuth) -->
        <form asp-controller="Account" asp-action="ExternalLogin" method="post">
            <button type="submit" name="provider" value="Google" class="btn-google" title="Iniciar sesión con Google">
                <svg width="20" height="20" viewBox="0 0 48 48">
                    <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.9 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 8 3l6-6C34.5 5.1 29.5 3 24 3 12.4 3 3 12.4 3 24s9.4 21 21 21 21-9.4 21-21c0-1.4-.1-2.7-.4-4z" />
                    <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.6 15.6 18.9 13 24 13c3.1 0 5.8 1.1 8 3l6-6C34.5 6.1 29.5 4 24 4 16.3 4 9.6 8.3 6.3 14.7z" />
                    <path fill="#4CAF50" d="M24 44c5.2 0 10.1-2 13.7-5.2l-6.3-5.3C29.4 35.4 26.8 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.7 16.2 44 24 44z" />
                    <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-1.1 3-3.4 5.4-6.3 6.8l6.3 5.3C39.4 36.8 44 30.9 44 24c0-1.4-.1-2.7-.4-3.5z" />
                </svg>
                Continuar con Google
            </button>
        </form>

        <!-- Enlace de Registro -->
        <div class="register-link">
            ¿No tenés cuenta? <a asp-controller="Account" asp-action="Register">Registrate</a>
        </div>
    </div>

</body>
</html>