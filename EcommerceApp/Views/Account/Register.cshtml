@model RegisterViewModel
@{
    ViewData["Title"] = "Crear cuenta";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crear cuenta - NexHard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
            body {
                margin: 0;
                padding: 0;
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background-image: url('/images/fondo-login.jpg');
                background-size: cover;
                background-position: center;
                background-attachment: fixed;
                font-family: 'Inter', sans-serif;
                color: #fff;
            }

            .login-card {
                background: rgba(10, 12, 22, 0.85);
                backdrop-filter: blur(16px);
                border: 1px solid rgba(0, 224, 255, 0.2);
                border-radius: 16px;
                box-shadow: 0 0 40px rgba(0, 224, 255, 0.15);
                padding: 40px;
                width: 100%;
                max-width: 420px;
                box-sizing: border-box;
            }

            h1 {
                font-family: 'Space Grotesk', sans-serif;
                font-size: 2rem;
                margin: 0 0 10px;
            }

            .sub {
                color: #a0aab5;
                font-size: 0.95rem;
                margin: 0 0 25px;
            }

            label {
                font-size: 0.85rem;
                color: #a0aab5;
                display: block;
                margin-bottom: 5px;
            }

            .form-control {
                width: 100%;
                padding: 14px 16px;
                background: rgba(0, 0, 0, 0.4);
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 10px;
                color: #fff;
                font-size: 0.95rem;
                box-sizing: border-box;
                margin-bottom: 15px;
            }

                .form-control:focus {
                    outline: none;
                    border-color: #00e0ff;
                    box-shadow: 0 0 0 3px rgba(0, 224, 255, 0.2);
                }

            .btn-primary {
                width: 100%;
                padding: 14px;
                background: linear-gradient(90deg, #00e0ff, #a020f0);
                border: none;
                border-radius: 10px;
                color: #fff;
                font-size: 1rem;
                font-weight: 600;
                cursor: pointer;
                margin-top: 10px;
            }

                .btn-primary:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 25px rgba(0, 224, 255, 0.4);
                }

            .text-danger {
                color: #ff4d4d;
                font-size: 0.85rem;
                display: block;
                margin-bottom: 10px;
            }

            .register-link {
                margin-top: 20px;
                text-align: center;
                font-size: 0.9rem;
                color: #a0aab5;
            }

                .register-link a {
                    color: #00e0ff;
                    text-decoration: none;
                    font-weight: 600;
                }

            .divider {
                display: flex;
                align-items: center;
                margin: 20px 0;
                color: #555;
                font-size: 0.8rem;
            }

                .divider::before, .divider::after {
                    content: '';
                    flex: 1;
                    border-bottom: 1px solid rgba(255,255,255,.1);
                }

                .divider::before {
                    margin-right: 15px;
                }

                .divider::after {
                    margin-left: 15px;
                }

            .btn-google {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                width: 100%;
                padding: 12px;
                background: rgba(255,255,255,.05);
                border: 1px solid rgba(255,255,255,.15);
                border-radius: 10px;
                color: #fff;
                text-decoration: none;
                font-size: 0.95rem;
                cursor: pointer;
            }
    </style>
</head>
<body>
    <div class="login-card">
        <h1>Crear cuenta</h1>
        <p class="sub">Regístrate para empezar a comprar</p>

        <form asp-action="Register" method="post">
            @* ⬇️ MUESTRA TODOS LOS ERRORES DE VALIDACIÓN *@
            <div asp-validation-summary="All" class="text-danger"></div>

            <label asp-for="FullName">Nombre completo</label>
            <input asp-for="FullName" class="form-control" placeholder="Tu nombre" />
            <span asp-validation-for="FullName" class="text-danger"></span>

            <label asp-for="Email">Correo</label>
            <input asp-for="Email" class="form-control" placeholder="vos@ejemplo.com" />
            <span asp-validation-for="Email" class="text-danger"></span>

            <label asp-for="Password">Contraseña</label>
            <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
            <span asp-validation-for="Password" class="text-danger"></span>

            <button type="submit" class="btn-primary">Crear cuenta</button>
        </form>

        <div class="divider">o</div>

        <form asp-controller="Account" asp-action="ExternalLogin" method="post">
            <button type="submit" name="provider" value="Google" class="btn-google">
                <img src="https://www.google.com/favicon.ico" width="20" height="20" />
                Continuar con Google
            </button>
        </form>

        <div class="register-link">
            ¿Ya tenés cuenta? <a asp-action="Login">Iniciá sesión</a>
        </div>
    </div>
</body>
</html>