@model List<EcommerceApp.Models.Order>
@{
    ViewData["Title"] = "Mis Pedidos";
    var estadoFiltro = ViewBag.EstadoFiltro as string;
}

<div class="wt-orders-page">
    <div class="container">
        <div class="wt-orders-header">
            <h1 class="wt-orders-title">📦 Mis Pedidos</h1>
            <p class="wt-orders-subtitle">Historial completo de tus compras en NexHard</p>
        </div>

        <!-- FILTROS -->
        <div class="wt-orders-filters">
            <a asp-action="MyOrders" class="wt-orders-filter-chip @(estadoFiltro == null ? "active" : "")">Todos</a>
            <a asp-action="MyOrders" asp-route-estado="Pendiente" class="wt-orders-filter-chip @(estadoFiltro == "Pendiente" ? "active" : "")">🟡 Pendientes</a>
            <a asp-action="MyOrders" asp-route-estado="Pagado" class="wt-orders-filter-chip @(estadoFiltro == "Pagado" ? "active" : "")">🔵 Pagados</a>
            <a asp-action="MyOrders" asp-route-estado="Enviado" class="wt-orders-filter-chip @(estadoFiltro == "Enviado" ? "active" : "")">🟠 Enviados</a>
            <a asp-action="MyOrders" asp-route-estado="Entregado" class="wt-orders-filter-chip @(estadoFiltro == "Entregado" ? "active" : "")">🟢 Entregados</a>
        </div>

        @if (!Model.Any())
        {
            <div class="wt-empty-orders">
                <div class="wt-empty-orders-icon">📦</div>
                <h2>No tienes pedidos aún</h2>
                <p>Cuando realices tu primera compra, aparecerá aquí</p>
                <a asp-controller="Products" asp-action="Index" class="wt-btn-primary">Explorar Componentes →</a>
            </div>
        }
        else
        {
            <div class="wt-orders-list">
                @foreach (var order in Model)
                {
                    <div class="wt-order-card">
                        <div class="wt-order-header">
                            <div>
                                <span class="wt-order-num">@order.NumeroOrden</span>
                                <span class="wt-order-date">📅 @order.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <span class="wt-status wt-status-@order.Estado.ToLower()">@order.Estado</span>
                        </div>

                        <div class="wt-order-products">
                            @foreach (var detail in order.Details.Take(4))
                            {
                                <div class="wt-order-prod-mini">
                                    @if (!string.IsNullOrEmpty(detail.ProductImage))
                                    {
                                        <img src="@detail.ProductImage" alt="@detail.ProductName"
                                             onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=&quot;wt-order-prod-placeholder&quot;>🖥️</div>';" />
                                    }
                                    else
                                    {
                                        <div class="wt-order-prod-placeholder">🖥️</div>
                                    }
                                </div>
                            }
                            @if (order.Details.Count > 4)
                            {
                                <div class="wt-more-products">+@(order.Details.Count - 4)</div>
                            }
                        </div>

                        <div class="wt-order-footer">
                            <div class="wt-order-total-info">
                                <span class="wt-order-count">@order.Details.Sum(d => d.Quantity) producto(s)</span>
                                <strong class="wt-order-total">Bs @order.Total.ToString("N2")</strong>
                            </div>
                            <a asp-action="Details" asp-route-id="@order.Id" class="wt-btn-order-detail">Ver Detalles →</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>