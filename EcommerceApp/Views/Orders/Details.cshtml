@model EcommerceApp.Models.Order
@{
    ViewData["Title"] = $"Pedido {Model.NumeroOrden}";
    bool isAdmin = ViewBag.IsAdmin ?? false;
}

<div class="wt-order-detail-page">
    <div class="container">
        @if (isAdmin)
        {
            <a asp-action="AllOrders" class="wt-back-link">← Volver a todos los pedidos</a>
        }
        else
        {
            <a asp-action="MyOrders" class="wt-back-link">← Volver a mis pedidos</a>
        }

        <div class="wt-order-detail-header">
            <div>
                <h1 class="wt-order-detail-title">Pedido @Model.NumeroOrden</h1>
                <p class="wt-order-detail-date">Realizado el @Model.Fecha.ToLocalTime().ToString("dd/MM/yyyy 'a las' HH:mm")</p>
            </div>
            <span class="wt-status wt-status-@Model.Estado.ToLower()">@Model.Estado</span>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="wt-alert wt-alert-success">✅ @TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="wt-alert wt-alert-error">⚠️ @TempData["Error"]</div>
        }

        <div class="wt-order-detail-layout">
            <div class="wt-order-detail-main">
                @if (isAdmin)
                {
                    <div class="wt-detail-card-box">
                        <h2>👤 Cliente</h2>
                        <div class="wt-success-row">
                            <span>Email</span>
                            <strong>@(Model.User?.Email ?? "N/A")</strong>
                        </div>
                        <div class="wt-success-row">
                            <span>Nombre</span>
                            <strong>@(Model.User?.FullName ?? "N/A")</strong>
                        </div>
                    </div>
                }

                <div class="wt-detail-card-box">
                    <h2>📦 Productos</h2>
                    @foreach (var item in Model.Details)
                    {
                        <div class="wt-order-product-row">
                            <div class="wt-order-product-img">
                                @if (!string.IsNullOrEmpty(item.ProductImage))
                                {
                                    <img src="@item.ProductImage" alt="@item.ProductName"
                                         onerror="this.parentElement.innerHTML='<div class=&quot;wt-order-prod-placeholder&quot;>🖥️</div>';" />
                                }
                                else
                                {
                                    <div class="wt-order-prod-placeholder">🖥️</div>
                                }
                            </div>
                            <div class="wt-order-product-info">
                                <h3>@item.ProductName</h3>
                                <p>@item.Quantity × Bs @item.Price.ToString("N2")</p>
                            </div>
                            <div class="wt-order-product-subtotal">Bs @item.Subtotal.ToString("N2")</div>
                        </div>
                    }
                </div>

                <div class="wt-detail-card-box">
                    <h2>📍 Datos de Envío</h2>
                    <div class="wt-success-row">
                        <span>Dirección</span>
                        <strong>@Model.DireccionEnvio</strong>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Ciudad))
                    {
                        <div class="wt-success-row">
                            <span>Ciudad</span>
                            <strong>@Model.Ciudad</strong>
                        </div>
                    }
                    <div class="wt-success-row">
                        <span>Teléfono</span>
                        <strong>@Model.Telefono</strong>
                    </div>
                    <div class="wt-success-row">
                        <span>Método de pago</span>
                        <strong>@Model.MetodoPago</strong>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Notas))
                    {
                        <div class="wt-success-row">
                            <span>Notas</span>
                            <strong>@Model.Notas</strong>
                        </div>
                    }
                </div>

                @if (isAdmin)
                {
                    <div class="wt-detail-card-box">
                        <h2>⚙️ Cambiar Estado</h2>
                        <form asp-action="UpdateStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="wt-status-buttons">
                                <button type="submit" name="nuevoEstado" value="Pendiente" class="wt-status-btn wt-status-btn-pendiente @(Model.Estado == "Pendiente" ? "active" : "")">🟡 Pendiente</button>
                                <button type="submit" name="nuevoEstado" value="Pagado" class="wt-status-btn wt-status-btn-pagado @(Model.Estado == "Pagado" ? "active" : "")">🔵 Pagado</button>
                                <button type="submit" name="nuevoEstado" value="Enviado" class="wt-status-btn wt-status-btn-enviado @(Model.Estado == "Enviado" ? "active" : "")">🟠 Enviado</button>
                                <button type="submit" name="nuevoEstado" value="Entregado" class="wt-status-btn wt-status-btn-entregado @(Model.Estado == "Entregado" ? "active" : "")">🟢 Entregado</button>
                                <button type="submit" name="nuevoEstado" value="Cancelado" class="wt-status-btn wt-status-btn-cancelado @(Model.Estado == "Cancelado" ? "active" : "")" onclick="return confirm('¿Cancelar este pedido?');">🔴 Cancelado</button>
                            </div>
                        </form>
                    </div>
                }
            </div>

            <aside class="wt-checkout-summary">
                <h2 class="wt-cart-summary-title">Resumen</h2>
                <div class="wt-summary-row">
                    <span>Subtotal</span>
                    <span>Bs @Model.Subtotal.ToString("N2")</span>
                </div>
                <div class="wt-summary-row">
                    <span>Envío</span>
                    <span>
                        @if (Model.Envio == 0)
                        {
                            <span class="wt-envio-gratis">🎉 ¡GRATIS!</span>
                        }
                        else
                        {
                            <text>Bs @Model.Envio.ToString("N2")</text>
                        }
                    </span>
                </div>
                <div class="wt-summary-divider"></div>
                <div class="wt-summary-total">
                    <span class="wt-summary-total-label">Total</span>
                    <span class="wt-summary-total-value">Bs @Model.Total.ToString("N2")</span>
                </div>
                <div class="wt-envio-info" style="text-align:center;">
                    @if (isAdmin)
                    {
                        <text>👤 Vista de administrador</text>
                    }
                    else
                    {
                        <text>💡 Guarda tu número de pedido</text>
                    }
                </div>
            </aside>
        </div>
    </div>
</div>