@{
    ViewData["Title"] = "Finalizar Compra";
}

<div class="wt-checkout-page">
    <div class="container">
        <div class="wt-checkout-header">
            <h1 class="wt-checkout-title">🛍️ Finalizar Compra</h1>
            <p class="wt-checkout-subtitle">Completa tus datos para confirmar el pedido</p>
        </div>

        <form asp-action="Confirm" method="post">
            @Html.AntiForgeryToken()

            <div class="wt-checkout-layout">
                <!-- IZQUIERDA -->
                <div class="wt-checkout-main">
                    <div class="wt-checkout-card">
                        <h2 class="wt-checkout-card-title">📍 Dirección de Envío</h2>

                        <div class="wt-form-group">
                            <label for="direccionEnvio">Dirección completa *</label>
                            <input type="text" id="direccionEnvio" name="direccionEnvio"
                                   class="wt-form-control" placeholder="Ej: Av. América #123, Zona Centro" required />
                        </div>

                        <div class="wt-form-row">
                            <div class="wt-form-group">
                                <label for="ciudad">Ciudad</label>
                                <input type="text" id="ciudad" name="ciudad"
                                       class="wt-form-control" placeholder="Ej: Cochabamba" />
                            </div>
                            <div class="wt-form-group">
                                <label for="telefono">Teléfono *</label>
                                <input type="tel" id="telefono" name="telefono"
                                       class="wt-form-control" placeholder="Ej: 77777777" required />
                            </div>
                        </div>

                        <div class="wt-form-group">
                            <label for="notas">Notas adicionales (opcional)</label>
                            <textarea id="notas" name="notas" class="wt-form-control" rows="3"
                                      placeholder="Ej: Entregar por la tarde..."></textarea>
                        </div>
                    </div>

                    <div class="wt-checkout-card">
                        <h2 class="wt-checkout-card-title">💳 Método de Pago</h2>

                        <div class="wt-payment-options">
                            <label class="wt-payment-option">
                                <input type="radio" name="metodoPago" value="QR" checked />
                                <div class="wt-payment-content">
                                    <span class="wt-payment-icon">📱</span>
                                    <div class="wt-payment-text">
                                        <strong>Pago con QR</strong>
                                        <span>Escanea el código y paga desde tu app bancaria</span>
                                    </div>
                                </div>
                            </label>

                            <label class="wt-payment-option">
                                <input type="radio" name="metodoPago" value="Tarjeta" />
                                <div class="wt-payment-content">
                                    <span class="wt-payment-icon">💳</span>
                                    <div class="wt-payment-text">
                                        <strong>Tarjeta de crédito/débito</strong>
                                        <span>Pago seguro con encriptación SSL</span>
                                    </div>
                                </div>
                            </label>

                            <label class="wt-payment-option">
                                <input type="radio" name="metodoPago" value="Contra-entrega" />
                                <div class="wt-payment-content">
                                    <span class="wt-payment-icon">🚚</span>
                                    <div class="wt-payment-text">
                                        <strong>Contra-entrega</strong>
                                        <span>Paga al recibir tu pedido</span>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- DERECHA -->
                <aside class="wt-checkout-summary">
                    <h2 class="wt-cart-summary-title">Resumen del Pedido</h2>

                    <div class="wt-summary-row">
                        <span>Subtotal</span>
                        <span id="checkout-subtotal">Bs 0.00</span>
                    </div>
                    <div class="wt-summary-row">
                        <span>Envío</span>
                        <span id="checkout-envio">Bs 0.00</span>
                    </div>

                    <div class="wt-summary-divider"></div>

                    <div class="wt-summary-total">
                        <span class="wt-summary-total-label">Total</span>
                        <span class="wt-summary-total-value" id="checkout-total">Bs 0.00</span>
                    </div>

                    <button type="submit" class="wt-btn-confirm">✅ Confirmar Pedido</button>
                    <a asp-controller="Cart" asp-action="Index" class="wt-btn-back">← Volver al Carrito</a>
                </aside>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        fetch('/Cart/GetTotal')
            .then(r => r.json())
            .then(data => {
                const subtotal = data.subtotal;
                const envio = subtotal >= 500 ? 0 : (subtotal > 0 ? 20 : 0);
                const total = subtotal + envio;

                document.getElementById('checkout-subtotal').textContent = 'Bs ' + subtotal.toFixed(2);
                document.getElementById('checkout-envio').innerHTML = envio === 0
                    ? '<span class="wt-envio-gratis">🎉 ¡GRATIS!</span>'
                    : 'Bs ' + envio.toFixed(2);
                document.getElementById('checkout-total').textContent = 'Bs ' + total.toFixed(2);
            });
    });
</script>
}