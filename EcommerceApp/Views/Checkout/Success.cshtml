@model EcommerceApp.Models.Order
@{
    ViewData["Title"] = "¡Pedido Confirmado!";
}

<div class="wt-success-page">
    <div class="container">
        <div class="wt-success-card">
            <div class="wt-success-icon">🎉</div>
            <h1>¡Pedido Confirmado!</h1>
            <p class="wt-success-message">Gracias por tu compra. Te contactaremos pronto para coordinar la entrega.</p>

            <div class="wt-success-order-num">
                <span>Número de orden:</span>
                <strong>@Model.NumeroOrden</strong>
            </div>

            <div class="wt-success-details">
                <div class="wt-success-row">
                    <span>📅 Fecha</span>
                    <strong>@Model.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
                <div class="wt-success-row">
                    <span>📍 Dirección</span>
                    <strong>@Model.DireccionEnvio</strong>
                </div>
                <div class="wt-success-row">
                    <span>📱 Teléfono</span>
                    <strong>@Model.Telefono</strong>
                </div>
                <div class="wt-success-row">
                    <span>💳 Método de pago</span>
                    <strong>@Model.MetodoPago</strong>
                </div>
                <div class="wt-success-row">
                    <span>📦 Estado</span>
                    <span class="wt-status wt-status-@Model.Estado.ToLower()">@Model.Estado</span>
                </div>
            </div>

            <div class="wt-success-products">
                <h3>Productos</h3>
                @foreach (var detail in Model.Details)
                {
                    <div class="wt-success-product">
                        <span>@detail.Quantity × @detail.ProductName</span>
                        <strong>Bs @detail.Subtotal.ToString("N2")</strong>
                    </div>
                }
            </div>

            <div class="wt-success-total">
                <span>Total Pagado</span>
                <strong>Bs @Model.Total.ToString("N2")</strong>
            </div>

            <div class="wt-success-actions">
                <a asp-controller="Products" asp-action="Index" class="wt-btn-primary">Seguir Comprando</a>
                <a asp-controller="Orders" asp-action="MyOrders" class="wt-btn-outline">Ver Mis Pedidos</a>
            </div>
        </div>
    </div>
</div>