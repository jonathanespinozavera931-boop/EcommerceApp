@model EcommerceApp.Models.Product
@{
    ViewData["Title"] = "Editar Producto";
}

<div class="form-page">
    <h1>Editar Producto</h1>
    <div class="form-shell">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <label asp-for="Name">Nombre</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>

            <label asp-for="Description">Descripción</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>

            <label asp-for="Price">Precio</label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>

            <label asp-for="Stock">Stock</label>
            <input asp-for="Stock" class="form-control" />
            <span asp-validation-for="Stock" class="text-danger"></span>

            <label asp-for="Category">Categoría</label>
            <input asp-for="Category" class="form-control" />
            <span asp-validation-for="Category" class="text-danger"></span>

            <label asp-for="ImageUrl">URL de imagen (opcional)</label>
            <input asp-for="ImageUrl" class="form-control" />

            <div class="d-flex gap-2 mt-2">
                <button type="submit" class="btn glass-btn">Guardar cambios</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>