@model IEnumerable<EcommerceApp.Models.Product>
@{
    ViewData["Title"] = "Productos";
    bool isAdmin = User.IsInRole("Admin");
    var categoriaActual = ViewBag.CategoriaActual as string;
    var categorias = ViewBag.Categorias as List<string> ?? new List<string>();
    var productos = Model.ToList();

    string IconFor(string? category) => category switch
    {
        "GPU" => "🎮",
        "CPU" => "🧠",
        "RAM" => "💾",
        "Almacenamiento" => "💿",
        "Placa Madre" => "🔌",
        "Fuente" => "⚡",
        "Refrigeración" => "❄️",
        "Gabinete" => "📦",
        "Monitor" => "🖥️",
        "Periférico" => "🖱️",
        _ => "🔧"
    };
}

<div class="iris-catalog">
    <div class="container">

        <!-- BOTÓN FILTRO MÓVIL -->
        <button id="mobileFilterBtn" class="iris-mobile-filter">☰ Categorías</button>

        <div class="iris-catalog-layout">

            <!-- ============ SIDEBAR ============ -->
            <aside class="iris-catalog-sidebar" id="irisSidebar">
                <h3 class="iris-sidebar-title">📦 Productos</h3>

                <ul class="iris-category-list">
                    <li>
                        <a class="iris-category-link @(string.IsNullOrEmpty(categoriaActual) ? "active" : "")"
                           asp-action="Index">
                            <span class="iris-category-link-text">
                                <span>🔧</span> Todos los productos
                            </span>
                            <span class="iris-category-count-badge">@productos.Count</span>
                        </a>
                    </li>

                    @foreach (var cat in categorias)
                    {
                        var count = productos.Count(p => p.Category == cat);
                        <li>
                            <a class="iris-category-link @(categoriaActual == cat ? "active" : "")"
                               asp-action="Index" asp-route-category="@cat">
                                <span class="iris-category-link-text">
                                    <span>@IconFor(cat)</span> @cat
                                </span>
                                <span class="iris-category-count-badge">@count</span>
                            </a>
                        </li>
                    }
                </ul>

                <!-- Banner promocional -->
                <div class="iris-sidebar-promo">
                    <div class="iris-sidebar-promo-content">
                        <h4 class="iris-sidebar-promo-title">
                            Juega<br />
                            <span class="highlight">SIN LÍMITES</span>
                        </h4>
                        <p class="iris-sidebar-promo-text">
                            Descubrí las GPUs más potentes del mercado
                        </p>
                        <a asp-action="Index" asp-route-category="GPU" class="iris-sidebar-promo-btn">
                            Ver GPUs →
                        </a>
                    </div>
                </div>
            </aside>

            <!-- ============ CONTENIDO ============ -->
            <div class="iris-catalog-main">

                <!-- Header -->
                <div class="iris-catalog-header">
                    <div class="iris-catalog-header-info">
                        <h1 class="iris-catalog-title">@(categoriaActual ?? "Productos")</h1>
                        <span class="iris-catalog-count">@productos.Count productos encontrados</span>
                    </div>

                    <div class="iris-catalog-sort">
                        <label for="sortSelect">Ordenar por:</label>
                        <select id="sortSelect">
                            <option value="relevance">Más relevantes</option>
                            <option value="price-asc">Precio: menor a mayor</option>
                            <option value="price-desc">Precio: mayor a menor</option>
                            <option value="name">Nombre A-Z</option>
                        </select>
                    </div>
                </div>

                <!-- Búsqueda local -->
                <div class="iris-catalog-search">
                    <span class="iris-catalog-search-icon">🔍</span>
                    <input type="text" id="localSearch" placeholder="Buscar dentro de los resultados..." />
                </div>

                <!-- Grid -->
                <div class="iris-catalog-grid" id="productGrid">

                    @if (!productos.Any())
                    {
                        <div class="iris-catalog-empty">
                            <div class="iris-catalog-empty-icon">🔍</div>
                            <h3>Sin resultados</h3>
                            <p>No se encontraron productos en esta categoría</p>
                            <a asp-action="Index" class="wt-btn-primary">Ver todos los productos</a>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in productos)
                        {
                            <div class="iris-catalog-card"
                                 data-id="@item.Id"
                                 data-category="@item.Category"
                                 data-name="@item.Name"
                                 data-price="@item.Price"
                                 data-stock="@item.Stock">

                                <!-- IMAGEN -->
                                <a asp-action="Details" asp-route-id="@item.Id" class="iris-catalog-card-img">
                                    @if (item.Stock > 0 && item.Stock < 15)
                                    {
                                        <span class="iris-catalog-card-badge">🔥 ÚLTIMAS UNIDADES</span>
                                    }
                                    else if (item.Price > 1000)
                                    {
                                        <span class="iris-catalog-card-badge cyan">⭐ PREMIUM</span>
                                    }

                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name"
                                             onerror="this.style.display='none'; this.parentElement.innerHTML+='<div class=&quot;iris-catalog-card-placeholder&quot;>@IconFor(item.Category)</div>';" />
                                    }
                                    else
                                    {
                                        <div class="iris-catalog-card-placeholder">@IconFor(item.Category)</div>
                                    }
                                </a>

                                <!-- BODY -->
                                <div class="iris-catalog-card-body">
                                    <span class="iris-catalog-card-brand">@item.Category</span>

                                    <h3 class="iris-catalog-card-name">
                                        <a asp-action="Details" asp-route-id="@item.Id" style="color: inherit; text-decoration: none;">
                                            @item.Name
                                        </a>
                                    </h3>

                                    <p class="iris-catalog-card-desc">@item.Description</p>

                                    <div class="iris-catalog-card-footer">
                                        <div class="iris-catalog-card-price-block">
                                            <span class="iris-catalog-card-price">Bs @item.Price.ToString("N2")</span>
                                            @if (item.Stock > 0)
                                            {
                                                <span class="iris-catalog-card-stock in">✓ En stock (@item.Stock)</span>
                                            }
                                            else
                                            {
                                                <span class="iris-catalog-card-stock out">✗ Agotado</span>
                                            }
                                        </div>

                                        <button class="iris-catalog-card-cart add-to-cart-btn"
                                                data-id="@item.Id"
                                                data-name="@item.Name"
                                                title="Agregar al carrito"
                                            @(item.Stock <= 0 ? "disabled" : "")>
                                            🛒
                                        </button>
                                    </div>

                                    @if (isAdmin)
                                    {
                                        <div class="iris-catalog-card-admin">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="iris-catalog-admin-btn">✏️ Editar</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="iris-catalog-admin-btn danger">🗑️ Borrar</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Formulario oculto para token anti-forgery -->
<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/shop.js"></script>
    <script>
        // ============ BUSCADOR LOCAL ============
        document.getElementById('localSearch')?.addEventListener('input', function () {
            const term = this.value.toLowerCase().trim();
            document.querySelectorAll('.iris-catalog-card').forEach(card => {
                const name = card.dataset.name.toLowerCase();
                card.style.display = name.includes(term) ? '' : 'none';
            });
        });

        // ============ ORDENAR ============
        document.getElementById('sortSelect')?.addEventListener('change', function () {
            const grid = document.getElementById('productGrid');
            const cards = Array.from(grid.querySelectorAll('.iris-catalog-card'));
            const sortBy = this.value;

            cards.sort((a, b) => {
                if (sortBy === 'price-asc') return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
                if (sortBy === 'price-desc') return parseFloat(b.dataset.price) - parseFloat(a.dataset.price);
                if (sortBy === 'name') return a.dataset.name.localeCompare(b.dataset.name);
                return 0;
            });

            cards.forEach(card => grid.appendChild(card));
        });

        // ============ SIDEBAR MÓVIL ============
        const mobileBtn = document.getElementById('mobileFilterBtn');
        const sidebar = document.getElementById('irisSidebar');

        mobileBtn?.addEventListener('click', () => {
            sidebar.classList.toggle('open');
        });

        // Cerrar sidebar al hacer clic en una categoría
        document.querySelectorAll('.iris-category-link').forEach(link => {
            link.addEventListener('click', () => {
                sidebar.classList.remove('open');
            });
        });
    </script>
}