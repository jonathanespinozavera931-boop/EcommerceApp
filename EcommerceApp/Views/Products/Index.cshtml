@model IEnumerable<EcommerceApp.Models.Product>
@{
    ViewData["Title"] = "Componentes";
    bool isAdmin = User.IsInRole("Admin");
    var categories = Model.Select(p => p.Category).Distinct().OrderBy(c => c).ToList();
    var featured = Model.OrderByDescending(p => p.Price).Take(3).ToList();
    var tags = new[] { "🔥 Más vendido", "⭐ Mejor valorado", "🆕 Nuevo" };

    string IconFor(string? category) => category switch
    {
        "GPU" => "🎮",
        "CPU" => "🧠",
        "RAM" => "💾",
        "Almacenamiento" => "💿",
        "Placa Madre" => "🔌",
        "Fuente" => "⚡",
        "Refrigeración" => "❄️",
        "Gabinete" => "🖥️",
        "Monitor" => "🖵",
        "Periférico" => "🖱️",
        _ => "🔧"
    };
    string ClassFor(string? category) => "cat-" + (category ?? "").Replace(" ", "").ToLower();
}

<div class="catalog-hero">
    <span class="hero-eyebrow">⚙ COMPONENTES PARA PC</span>
    <h1>Construí la máquina de <span class="grad-text">tus sueños</span></h1>
    <p>Encontrá el hardware ideal para tu próxima configuración.</p>
</div>

<button id="mobileFilterBtn" class="btn-secondary mobile-filter-btn" style="margin-bottom:16px;">☰ Filtros</button>

<div class="catalog-layout">
    <aside class="catalog-sidebar" id="filterSidebar">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h3>Filtros</h3>
            <button id="closeMobileFilter" class="mobile-filter-btn btn-secondary" style="padding:4px 10px;">✕</button>
        </div>
        <div class="filter-group">
            <label>Categoría</label>
            <div class="filter-options">
                <button class="filter-chip active" data-cat="all">Todos los componentes</button>
                @foreach (var cat in categories)
                {
                    <button class="filter-chip" data-cat="@cat">@IconFor(cat) @cat</button>
                }
            </div>
        </div>
        <button id="clearFilters" class="btn-secondary" style="width:100%;">Limpiar filtros</button>
    </aside>

    <div class="catalog-main">
        <div class="catalog-toolbar">
            <input id="searchInput" class="form-control search-input" placeholder="Buscar por nombre..." />
            <select id="sortSelect" class="form-control sort-select">
                <option value="relevance">Más relevantes</option>
                <option value="price-asc">Precio: menor a mayor</option>
                <option value="price-desc">Precio: mayor a menor</option>
                <option value="name">Nombre A-Z</option>
            </select>
        </div>

        @if (featured.Any())
        {
            <h2 class="section-title">🔥 Productos destacados</h2>
            <div class="featured-grid">
                @for (int i = 0; i < featured.Count; i++)
                {
                    var p = featured[i];
                    <div class="featured-card @ClassFor(p.Category)">
                        <span class="fc-tag">@tags[i % tags.Length]</span>
                        <span class="fc-icon">@IconFor(p.Category)</span>
                        <h4>@p.Name</h4>
                        <div class="price">Bs @p.Price.ToString("N2")</div>
                        <a asp-action="Details" asp-route-id="@p.Id" class="btn-glass-sm primary" style="margin-top:10px; width:fit-content; padding:8px 18px;">Comprar ahora →</a>
                    </div>
                }
            </div>
        }

        <div class="page-header">
            <h2 class="section-title" style="margin:0;">Todo el catálogo</h2>
            @if (isAdmin)
            {
                <a asp-action="Create" class="btn-glass-sm primary" style="flex:none; padding:10px 18px;">+ Crear Producto</a>
            }
        </div>

        <div class="product-grid" id="productGrid">
            @foreach (var item in Model)
            {
                <div class="product-card"
                     data-id="@item.Id" data-category="@item.Category" data-name="@item.Name"
                     data-price="@item.Price" data-stock="@item.Stock" data-desc="@item.Description"
                     data-icon="@IconFor(item.Category)" data-img-class="@ClassFor(item.Category)"
                     data-img-url="@item.ImageUrl">
                    <!-- Imagen del producto (fuera del pc-top para que se vea bien) -->
                    <div class="product-image-wrapper" style="position:relative; height:160px; border-radius:14px; overflow:hidden; margin-bottom:14px; background: linear-gradient(135deg, rgba(0,224,255,0.08), rgba(160,32,240,0.08));">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name"
                                 style="width:100%; height:100%; object-fit:cover; display:block;"
                                 onerror="this.style.display='none'; this.parentElement.innerHTML='<div style=\'display:flex;align-items:center;justify-content:center;height:100%;font-size:3.5rem;opacity:0.5;\'>@IconFor(item.Category)</div>';" />
                        }
                        else
                        {
                            <div style="display:flex;align-items:center;justify-content:center;height:100%;font-size:3.5rem;opacity:0.5;">
                                @IconFor(item.Category)
                            </div>
                        }

                        <!-- Botones flotantes (arriba a la derecha) -->
                        <div style="position:absolute; top:10px; right:10px; display:flex; gap:6px;">
                            <button class="pc-fav" data-id="@item.Id" style="background:rgba(0,0,0,0.5); border:1px solid rgba(255,255,255,0.2); color:#fff; width:34px; height:34px; border-radius:50%; cursor:pointer;">♡</button>
                            <button class="pc-quick" style="background:rgba(0,0,0,0.5); border:1px solid rgba(255,255,255,0.2); color:#fff; width:34px; height:34px; border-radius:50%; cursor:pointer;">👁</button>
                        </div>
                    </div>
                    <span class="category-badge">@IconFor(item.Category) @item.Category</span>
                    <h3>@item.Name</h3>
                    <p class="desc">@item.Description</p>
                    <div class="product-footer">
                        <span class="price">Bs @item.Price.ToString("N2")</span>
                        @if (item.Stock > 0)
                        {
                            <span class="stock-badge stock-in">En stock (@item.Stock)</span>
                        }
                        else
                        {
                            <span class="stock-badge stock-out">Agotado</span>
                        }
                    </div>
                    <div class="qty-row">
                        <button class="qty-btn qty-minus">−</button>
                        <span class="qty-val">1</span>
                        <button class="qty-btn qty-plus">+</button>
                    </div>
                    <button class="btn-cart add-to-cart-btn"
                            data-id="@item.Id"
                            data-name="@item.Name">
                        🛒 Agregar al carrito
                    </button>   
                    <div class="card-actions" style="margin-top:8px;">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-glass-sm">Ver</a>
                        @if (isAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-glass-sm">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-glass-sm">Borrar</a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="quick-view-overlay" id="quickViewOverlay">
    <div class="quick-view-modal">
        <button class="qv-close" id="qvClose">✕</button>
        <div class="qv-image" id="qvImage"></div>
        <span class="category-badge" id="qvCategory"></span>
        <h2 id="qvName"></h2>
        <p class="desc" id="qvDesc" style="-webkit-line-clamp:unset; margin-bottom:16px;"></p>
        <div class="price" id="qvPrice"></div>
        <p style="color:var(--muted); font-size:13px; margin:6px 0 18px;">Stock: <span id="qvStock"></span></p>
    </div>
</div>
<!-- Formulario oculto para el token anti-forgery (necesario para AJAX) -->
<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/shop.js"></script>
}