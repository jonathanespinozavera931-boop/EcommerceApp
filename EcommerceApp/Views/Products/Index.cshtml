@model IEnumerable<EcommerceApp.Models.Product>
@{
    ViewData["Title"] = "Componentes";
    bool isAdmin = User.IsInRole("Admin");

    string IconFor(string? category) => category switch
    {
        "GPU" => "🎮",
        "CPU" => "🧠",
        "RAM" => "💾",
        "Almacenamiento" => "💿",
        "Placa Madre" => "🔌",
        "Fuente" => "⚡",
        "Refrigeración" => "❄️",
        "Gabinete" => "🖥️",
        "Monitor" => "🖵",
        "Periférico" => "🖱️",
        _ => "🔧"
    };
}

<div class="page-header">
    <h1>Componentes</h1>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn-glass-sm primary" style="flex:none; padding:10px 18px;">+ Crear Producto</a>
    }
</div>

<div class="product-grid">
    @foreach (var item in Model)
    {

        <div class="product-card">
            @{
                var catClass = "cat-" + (item.Category ?? "").Replace(" ", "").ToLower();
            }
            @if (!string.IsNullOrEmpty(item.ImageUrl))
            {
                <div class="product-image" style="background-image:url('@item.ImageUrl');"></div>
            }
            else
            {
                <div class="product-image @catClass"><span>@IconFor(item.Category)</span></div>
            }
            <span class="category-badge">@IconFor(item.Category) @item.Category</span>
            <h3>@item.Name</h3>
            <p class="desc">@item.Description</p>
            <div class="product-footer">
                <span class="price">Bs @item.Price.ToString("N2")</span>
                @if (item.Stock > 0)
                {
                    <span class="stock-badge stock-in">En stock (@item.Stock)</span>
                }
                else
                {
                    <span class="stock-badge stock-out">Agotado</span>
                }
            </div>
            <div class="card-actions">
                <a asp-action="Details" asp-route-id="@item.Id" class="btn-glass-sm">Ver</a>
                @if (isAdmin)
                {
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-glass-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-glass-sm">Borrar</a>
                }
            </div>
        </div>
    }
</div>